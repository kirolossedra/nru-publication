 static const uint32_t PACKET_SIZE = 1000;
 
+struct LatencyPacket
+{
+  std::string technology;
+  std::string flowId;
+  uint32_t sequence;
+  int64_t txNs;
+  int64_t rxNs;
+  uint32_t duplicates;
+  bool received;
+};
+
+static std::map<std::tuple<std::string, std::string, uint32_t>, LatencyPacket> g_latencyPackets;
+static uint64_t g_duplicateReceives = 0;
+static uint64_t g_unmatchedReceives = 0;
+
+static void
+LatencyTx (std::string technology, std::string flowId, Ptr<const Packet>,
+           const Address &, const Address &, const SeqTsSizeHeader &header)
+{
+  auto key = std::make_tuple (technology, flowId, header.GetSeq ());
+  LatencyPacket packet {technology, flowId, header.GetSeq (), header.GetTs ().GetNanoSeconds (),
+                        -1, 0, false};
+  auto inserted = g_latencyPackets.emplace (key, packet);
+  NS_ABORT_MSG_IF (!inserted.second, "Duplicate application TX sequence for " << flowId
+                   << " seq=" << header.GetSeq ());
+}
+
+static void
+LatencyRx (std::string technology, std::string flowId, Ptr<const Packet>,
+           const Address &, const Address &, const SeqTsSizeHeader &header)
+{
+  auto key = std::make_tuple (technology, flowId, header.GetSeq ());
+  auto packet = g_latencyPackets.find (key);
+  if (packet == g_latencyPackets.end ())
+    {
+      ++g_unmatchedReceives;
+      return;
+    }
+  if (packet->second.received)
+    {
+      ++packet->second.duplicates;
+      ++g_duplicateReceives;
+      return;
+    }
+  packet->second.rxNs = Simulator::Now ().GetNanoSeconds ();
+  packet->second.received = true;
+}
+
+static void
+WriteLatencyCsv (const std::string &path)
+{
+  std::ofstream csv (path);
+  NS_ABORT_MSG_IF (!csv.is_open (), "Cannot open latency CSV: " << path);
+  csv << "technology,flow_id,packet_id,tx_timestamp_ns,rx_timestamp_ns,latency_ns,status,duplicate_rx_count\n";
+  for (const auto &entry : g_latencyPackets)
+    {
+      const LatencyPacket &packet = entry.second;
+      csv << packet.technology << ',' << packet.flowId << ',' << packet.sequence << ','
+          << packet.txNs << ',';
+      if (packet.received)
+        {
+          int64_t latencyNs = packet.rxNs - packet.txNs;
+          NS_ABORT_MSG_IF (latencyNs < 0, "Negative end-to-end latency for " << packet.flowId);
+          csv << packet.rxNs << ',' << latencyNs << ",received,";
+        }
+      else
+        {
+          csv << ",,not_received_by_stop,";
+        }
+      csv << packet.duplicates << '\n';
+    }
+  NS_ABORT_MSG_IF (!csv.good (), "Failed writing latency CSV: " << path);
+}
